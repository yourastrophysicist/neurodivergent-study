{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/Neuro-Spices_Planner.pdf",
      "dest": "/Neuro-Spices_Planner.pdf",
      "headers": {
        "Content-Type": "application/pdf",
        "Content-Disposition": "attachment; filename=\"Neuro-Spices_Planner.pdf\""
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
